      - title: Menu Text
        value: First dialogue with Anna
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432, \u044F \u0440\u0430\u0434\u0430
          \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438
          \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E. \u042D\u0442\u043E
          \u043A\u043E\u043B\u044C\u0446\u043E\u2026 \u043E\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
          \u043C\u043D\u0435 \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0438. \u042F
          \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C
          \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u043C\u043E\u0433 \u0435\u0433\u043E
          \u0432\u0437\u044F\u0442\u044C."
        type: 0
        typeString: CustomFieldType_Text
